# Built binaries (anchored to the repo root so they never shadow source
# directories like cmd/token-collector/)
/zai-api
/zai-bridge
/token-collector

# Runtime artifacts (tokens.sqlite holds harvested device tokens — never commit)
tokens.sqlite
tokens.sqlite-shm
tokens.sqlite-wal
*.log

# Local environment
.env

